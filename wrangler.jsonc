{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "likha-webstudio",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public"
  },
  // Keep the old workers.dev URL working so existing links don't break.
  "workers_dev": true,
  "routes": [
    { "pattern": "likhawebstudioph.com", "custom_domain": true },
    { "pattern": "www.likhawebstudioph.com", "custom_domain": true }
  ]
}
